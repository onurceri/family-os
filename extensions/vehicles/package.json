{
	"name": "@famos/ext-vehicles",
	"version": "0.8.4",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"famos": {
		"id": "vehicles",
		"version": "0.8.4",
		"sdk": "^0.8.0",
		"dependsOn": [
			"records"
		],
		"optional": [
			"calendar"
		],
		"capabilities": [
			"vehicles.view",
			"vehicles.edit"
		],
		"calls": [
			"records.addObligation",
			"records.archiveForRecord",
			"records.dueBetween",
			"records.renameRecord"
		]
	},
	"exports": {
		"./messages/*": "./src/messages/*",
		"./contract": "./src/contract/index.ts",
		"./api": {
			"types": "./src/web/api.gen.d.ts"
		},
		"./server": "./src/server/index.ts",
		"./web": {
			"svelte": "./src/web/index.ts",
			"default": "./src/web/index.ts"
		}
	},
	"scripts": {
		"build": "famos-pack",
		"typecheck": "tsc -p . && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings"
	},
	"dependencies": {
		"@famos/api-client": "workspace:*",
		"@famos/ext-records": "workspace:*",
		"@famos/sdk": "workspace:*",
		"@famos/time": "workspace:*",
		"@famos/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"kysely": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	},
	"devDependencies": {
		"@famos/ext-calendar": "workspace:*",
		"@famos/ext-inbox": "workspace:*",
		"@famos/pack": "workspace:*",
		"@famos/testing": "workspace:*",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	}
}
