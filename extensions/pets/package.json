{
	"name": "@famos/ext-pets",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"famos": {
		"id": "pets",
		"version": "0.1.0",
		"sdk": "^0.3.0",
		"dependsOn": [
			"records"
		],
		"capabilities": [
			"pets.view",
			"pets.edit"
		],
		"calls": [
			"records.addObligation",
			"records.archiveForRecord",
			"records.completeObligation",
			"records.renameRecord"
		]
	},
	"exports": {
		"./messages/*": "./src/messages/*",
		"./contract": "./src/contract/index.ts",
		"./server": "./src/server/index.ts",
		"./web": {
			"svelte": "./src/web/index.ts",
			"default": "./src/web/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc -p . && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings"
	},
	"dependencies": {
		"@famos/api-client": "workspace:*",
		"@famos/ext-records": "workspace:*",
		"@famos/sdk": "workspace:*",
		"@famos/time": "workspace:*",
		"@famos/ui": "workspace:*",
		"@lucide/svelte": "1.52.0",
		"kysely": "0.29.6",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"@famos/ext-inbox": "workspace:*",
		"svelte": "5.57.1"
	},
	"devDependencies": {
		"@famos/testing": "workspace:*",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	}
}
