										"pattern": "^asst_thread_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
										"description": "Omit to start a new thread"
									},
									"text": {
										"type": "string",
										"minLength": 1,
										"maxLength": 4000
									}
								},
								"required": [
