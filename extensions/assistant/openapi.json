														}
													},
													"required": [
														"threadId",
														"messageId",
														"replyId"
													]
												}
											},
											"required": [
												"status",
												"output"
											]
										},
										{
											"type": "object",
											"properties": {
												"status": {
													"type": "string",
													"enum": [
														"drafted"
													]
												},
												"draftId": {
													"type": "string"
												}
