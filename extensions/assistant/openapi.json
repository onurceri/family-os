		"/api/v1/actions/assistant.sendMessage": {
			"post": {
				"operationId": "assistant.sendMessage",
				"summary": "Ask the assistant",
				"description": "Stores the message and enqueues the assistant’s turn; the answer arrives over the WebSocket.",
				"tags": [
					"actions",
					"assistant"
				],
				"security": [
					{
						"session": []
					}
				],
				"parameters": [
					{
						"schema": {
							"type": "string",
							"pattern": "^[A-Za-z0-9_-]{1,100}$",
							"description": "Makes the call safe to repeat (1-100 characters: letters, digits, `_`, `-`). The same key for the same action returns the first result without running it again (response header `Idempotent-Replayed: true`); for another action it is refused with 422. Keys are kept 7 days."
						},
						"required": false,
						"description": "Makes the call safe to repeat (1-100 characters: letters, digits, `_`, `-`). The same key for the same action returns the first result without running it again (response header `Idempotent-Replayed: true`); for another action it is refused with 422. Keys are kept 7 days.",
						"name": "idempotency-key",
						"in": "header"
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"threadId": {
