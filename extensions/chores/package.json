{
	"name": "@famos/ext-chores",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"famos": {
		"id": "chores",
		"version": "0.1.0",
		"sdk": "^0.8.0",
		"capabilities": [
			"chores.view",
			"chores.use",
			"chores.edit"
		]
	},
	"exports": {
		"./messages/*": "./src/messages/*",
		"./contract": "./src/contract/index.ts",
		"./api": {
			"types": "./src/web/api.gen.d.ts"
		},
		"./server": "./src/server/index.ts",
		"./web": {
			"svelte": "./src/web/index.ts",
			"default": "./src/web/index.ts"
		}
	},
	"scripts": {
		"build": "famos-pack",
		"typecheck": "tsc -p . && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings"
	},
	"dependencies": {
		"@famos/api-client": "workspace:*",
		"@famos/sdk": "workspace:*",
		"@famos/time": "workspace:*",
		"@famos/ui": "workspace:*",
		"@lucide/svelte": "1.52.0",
		"kysely": "0.29.6",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"svelte": "5.57.1"
	},
	"devDependencies": {
		"@famos/pack": "workspace:*",
		"@famos/testing": "workspace:*",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	}
}
