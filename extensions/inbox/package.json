{
	"name": "@famos/ext-inbox",
	"version": "0.7.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"famos": {
		"id": "inbox",
		"version": "0.7.0",
		"sdk": "^0.8.0",
		"optional": [
			"records"
		],
		"capabilities": [
			"inbox.share"
		],
		"provides": [
			"shareTarget"
		],
		"calls": [
			"core.decidableSources",
			"records.attachDocument"
		]
	},
	"exports": {
		"./messages/*": "./src/messages/*",
		"./contract": "./src/contract/index.ts",
		"./api": {
			"types": "./src/web/api.gen.d.ts"
		},
		"./server": "./src/server/index.ts",
		"./web": {
			"svelte": "./src/web/index.ts",
			"default": "./src/web/index.ts"
		}
	},
	"scripts": {
		"build": "famos-pack",
		"typecheck": "tsc -p . && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
		"eval": "tsx eval/run.ts"
	},
	"dependencies": {
		"@famos/api-client": "workspace:*",
		"@famos/i18n": "workspace:*",
		"@famos/sdk": "workspace:*",
		"@famos/time": "workspace:*",
		"@famos/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"kysely": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	},
	"devDependencies": {
		"@famos/ext-calendar": "workspace:*",
		"@famos/ext-lists": "workspace:*",
		"@famos/ext-records": "workspace:*",
		"@famos/pack": "workspace:*",
		"@famos/testing": "workspace:*",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tsx": "4.23.15",
		"typescript": "catalog:"
	}
}
