{
	"name": "famos",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24.12 <27"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build && node scripts/collect-extensions.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "turbo run typecheck",
		"gen": "turbo run gen",
		"lint": "biome check . && prettier --check \"**/*.svelte\" && depcruise --config .dependency-cruiser.cjs apps packages extensions && node scripts/check-dockerfile.mjs",
		"format": "biome check --write . && prettier --write \"**/*.svelte\"",
		"test:all": "pnpm lint && pnpm typecheck && pnpm test",
		"e2e": "pnpm build && pnpm --filter @famos/e2e e2e",
		"sweep": "pnpm build && pnpm --filter @famos/e2e sweep",
		"sweep:readme": "pnpm build && pnpm --filter @famos/e2e sweep:readme",
		"release": "node scripts/release.mjs",
		"lang:template": "node scripts/lang.ts template",
		"lang:check": "node scripts/lang.ts check",
		"theme:check": "node scripts/theme.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.4",
		"dependency-cruiser": "18.5.0",
		"pixelmatch": "8.0.0",
		"playwright-core": "1.63.0",
		"pngjs": "7.0.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.1",
		"turbo": "2.11.7",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	}
}
