{
	"name": "@famos/server",
	"version": "0.8.5",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "FAMOS_DEV_EXTENSIONS=../../extensions tsx watch --clear-screen=false src/main.ts serve",
		"typecheck": "tsc -p .",
		"gen": "FAMOS_DEV_EXTENSIONS=../../extensions tsx src/main.ts openapi openapi.json --extensions ../../extensions && FAMOS_DEV_EXTENSIONS=../../extensions tsx src/main.ts public-openapi public-openapi.json && tsx scripts/api-types.ts ../../extensions",
		"build": "node build.mjs"
	},
	"dependencies": {
		"@famos/adapters": "workspace:*",
		"@famos/core": "workspace:*",
		"@famos/db": "workspace:*",
		"@famos/i18n": "workspace:*",
		"@famos/sdk": "workspace:*",
		"@famos/themes": "workspace:*",
		"@famos/time": "workspace:*",
		"@hono/node-server": "2.1.3",
		"@hono/zod-openapi": "1.6.3",
		"@modelcontextprotocol/hono": "2.0.2",
		"@modelcontextprotocol/server": "2.3.1",
		"better-sqlite3": "13.0.3",
		"hono": "4.13.13",
		"kysely": "catalog:",
		"punycode": "2.3.1",
		"tar": "7.5.22",
		"ws": "8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@famos/pack": "workspace:*",
		"@famos/testing": "workspace:*",
		"@modelcontextprotocol/client": "2.3.1",
		"@types/ws": "8.18.2",
		"esbuild": "0.28.2",
		"openapi-typescript": "7.13.0",
		"tsx": "4.23.15"
	}
}
